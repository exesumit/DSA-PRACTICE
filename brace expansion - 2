class Solution {
public:

    set<string> solve(string &s, int &i) {
        set<string> ans;
        set<string> curr;

        curr.insert("");

        while(i < s.size() && s[i] != '}') {

            if(s[i] == ',') {
                for(string x : curr) {
                    ans.insert(x);
                }

                curr.clear();
                curr.insert("");
                i++;
            }

            else if(s[i] == '{') {
                i++;

                set<string> temp = solve(s, i);

                set<string> newCurr;

                for(string a : curr) {
                    for(string b : temp) {
                        newCurr.insert(a + b);
                    }
                }

                curr = newCurr;
                i++;
            }

            else {
                string ch = "";
                ch += s[i];

                set<string> newCurr;

                for(string x : curr) {
                    newCurr.insert(x + ch);
                }

                curr = newCurr;
                i++;
            }
        }

        for(string x : curr) {
            ans.insert(x);
        }

        return ans;
    }

    vector<string> braceExpansionII(string expression) {
        int i = 0;

        set<string> result = solve(expression, i);

        return vector<string>(result.begin(), result.end());
    }
};
