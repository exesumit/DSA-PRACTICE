class Solution {
public:
    int reverse(int x) {
        int a = 0;
        int digit;

        while (x != 0) {
            digit = x % 10;
            x = x / 10;

            // Check overflow before a*10 + digit
            if (a > INT_MAX / 10 || 
                (a == INT_MAX / 10 && digit > 7)) {
                return 0;
            }

            if (a < INT_MIN / 10 || 
                (a == INT_MIN / 10 && digit < -8)) {
                return 0;
            }

            a = a * 10 + digit;
        }

        return a;
    }
};
