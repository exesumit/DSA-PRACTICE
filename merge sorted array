class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {

        vector<int> nums3;

        int i = 0;
        int j = 0;

        while (m > 0) {
            nums3.push_back(nums1[i]);
            i++;
            m--;
        }

        while (n > 0) {
            nums3.push_back(nums2[j]);
            j++;
            n--;
        }

        sort(nums3.begin(), nums3.end());

        nums1 = nums3;
    }
};
